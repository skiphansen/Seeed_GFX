				<Exec CmdLine="vsdebugio -prog &quot;%o&quot;" />
			</Target>
			<Target Name="Execute" MenuCaption="E&amp;xecute" SaveOption="SaveNone" BuildFirst="1" CaptureOutputWith="ProcessBuffer" RunFromDir="%rw">
				<Exec CmdLine="&quot;%o&quot;" />
			</Target>
		</Menu>
	</Config>
